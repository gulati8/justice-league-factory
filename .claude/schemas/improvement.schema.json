{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Improvement Proposals",
  "description": "Improvement proposals produced by Oracle",
  "type": "object",
  "required": ["run_count_analyzed", "proposals"],
  "properties": {
    "run_count_analyzed": {
      "type": "integer",
      "description": "Number of factory runs in the eval history"
    },
    "patterns_detected": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Recurring patterns observed across runs"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_agent", "change_type", "current_value", "proposed_value", "rationale", "evidence", "risk_level"],
        "properties": {
          "target_agent": { "type": "string" },
          "change_type": {
            "type": "string",
            "enum": ["prompt", "tools", "contract", "new_agent", "skill"]
          },
          "current_value": { "type": "string" },
          "proposed_value": { "type": "string" },
          "rationale": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "References to specific eval-log entries that motivated this"
          },
          "risk_level": {
            "type": "string",
            "enum": ["safe", "needs_review", "dangerous"]
          }
        }
      }
    },
    "skill_health": {
      "type": "array",
      "description": "Per-skill health snapshot from telemetry. Pointer to where to look — not itself a proposal. Sort by priority_score descending.",
      "items": {
        "type": "object",
        "required": ["skill", "runs", "failure_rate", "last_reviewed", "staleness_days", "priority_score"],
        "properties": {
          "skill": { "type": "string", "description": "Skill name" },
          "runs": { "type": "integer", "description": "Number of agent runs that loaded this skill" },
          "failure_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of those runs that produced a fail verdict" },
          "last_reviewed": { "type": "string", "format": "date", "description": "From the skill's frontmatter" },
          "staleness_days": { "type": "integer", "minimum": 0, "description": "Days between last_reviewed and analysis run" },
          "priority_score": { "type": "number", "description": "staleness_days × failure_rate. Used to sort." }
        }
      }
    }
  }
}
